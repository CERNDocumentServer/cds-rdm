#communities-carousel{

  .carousel.item{
    background-color: @white;
  }

  .carousel-arrow {
    color: @carouselArrow;
  }
}


#records-list {

  width: 100%;

  h3, h4 {
    font-weight: normal;
  }

  h4 {
    a {
      color: @black;
    }
  }

  .title-background {
    background-color: @recordsListTitleBackground;
    a {
      color: @white !important;
    }
  }

  .content {
    width: 100%;
  }

  .relaxed.items > div:nth-child(even){
    background-color: @recordsListAltBackground;
  }

  .description{
    font-size: 1rem;
  }
}

#cds-linked-records {

  .linked-record-grid-card {
    height: 100%;

    .content {
      flex-grow: 1;
    }
  }

  .linked-record-grid-image {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: contain;
    background-color: @white;
  }

  .ui.cards {
    margin-left: -0.75em;
    margin-right: -0.75em;

    > .card {
      width: calc(33.333333% - 1.5em);
      margin: 0.75em;
    }
  }

  @media all and (max-width: @largestTabletScreen) {
    .ui.cards > .card {
      width: calc(50% - 1.5em);
    }
  }

  @media all and (max-width: @largestMobileScreen) {
    .ui.cards {
      margin-left: 0;
      margin-right: 0;

      > .card {
        width: 100%;
        margin: 0 0 1em;
      }
    }

    .linked-record-grid-image {
      height: 150px;
    }
  }
}
